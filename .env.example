# Copy to .env and fill in your own values:  cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-your-key-here

# ---------- PostgreSQL ----------
# Option A (production / Render): one URL. Takes priority when set.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
#
# Option B (local): individual settings, used when DATABASE_URL is not set
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=recruitmind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# ---------- LangSmith tracing (optional) ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=recruitmind-ai

# ---------- Auth / sessions (optional, defaults shown) ----------
# SESSION_HOURS=12
# REMEMBER_ME_DAYS=30
# SESSION_IDLE_MINUTES=120
# Force Secure cookies when TLS is terminated by a proxy in front of the app
# SESSION_COOKIE_SECURE=true
# Extra browser origins allowed to call the API (comma separated)
# TRUSTED_ORIGINS=https://app.example.com
